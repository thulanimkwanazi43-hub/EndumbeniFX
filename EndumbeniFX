class SignalEngine:
    def evaluate(self, symbol: str, market_data: Dict) -> Dict:
        timeframes = market_data.get("timeframes", {})
        h4 = timeframes.get("H4", [])
        h1 = timeframes.get("H1", [])
        m15 = timeframes.get("M15", [])
        m5 = timeframes.get("M5", [])

        if len(h4) < 20 or len(h1) < 20 or len(m15) < 15 or len(m5) < 10:
            return {
                "symbol": symbol,
                "direction": "FLAT",
                "score": 0.0,
                "confidence": 0.0,
                "status": "SKIPPED",
                "reason": "insufficient multi-timeframe data",
                "risk": 0.0,
                "stop_loss": 0.0,
                "take_profit": 0.0,
                "holding_minutes": 0,
                "max_hold_hours": 0,
                "atr": 0.0,
            }

        def trend_strength(values: List[float]) -> float:
            if len(values) < 20:
                return 0.0
            latest = values[-1]
            ma_slow = sum(values[-20:]) / 20
            return (latest - ma_slow) / ma_slow

        def momentum_strength(values: List[float]) -> float:
            if len(values) < 3:
                return 0.0
            return (values[-1] - values[-3]) / values[-3]

        h4_trend = trend_strength(h4)
        h1_trend = trend_strength(h1)
        m15_trend = trend_strength(m15)
        m5_trend = trend_strength(m5)

        h4_momentum = momentum_strength(h4)
        h1_momentum = momentum_strength(h1)
        m15_momentum = momentum_strength(m15)
        m5_momentum = momentum_strength(m5)

        score = 0.0
        confirmation_count = 0
        reasons = []

        if h4_trend > 0.002:
            score += 0.35
            confirmation_count += 1
            reasons.append("H4 bullish")
        elif h4_trend < -0.002:
            score -= 0.35
            confirmation_count += 1
            reasons.append("H4 bearish")

        if h1_trend > 0.0012 and h4_trend > 0:
            score += 0.22
            confirmation_count += 1
            reasons.append("H1 confirms uptrend")
        elif h1_trend < -0.0012 and h4_trend < 0:
            score -= 0.22
            confirmation_count += 1
            reasons.append("H1 confirms downtrend")
        else:
            return {
                "symbol": symbol,
                "direction": "FLAT",
                "score": 0.0,
                "confidence": 0.0,
                "status": "SKIPPED",
                "reason": "H4/H1 conflict",
                "risk": 0.0,
                "stop_loss": 0.0,
                "take_profit": 0.0,
                "holding_minutes": 0,
                "max_hold_hours": 0,
                "atr": 0.0,
            }

        if m15_trend > 0.0008 and m15_momentum > 0:
            score += 0.18
            confirmation_count += 1
            reasons.append("M15 bullish entry")
        elif m15_trend < -0.0008 and m15_momentum < 0:
            score -= 0.18
            confirmation_count += 1
            reasons.append("M15 bearish entry")
        else:
            return {
                "symbol": symbol,
                "direction": "FLAT",
                "score": 0.0,
                "confidence": 0.0,
                "status": "SKIPPED",
                "reason": "M15 entry weak or conflicting",
                "risk": 0.0,
                "stop_loss": 0.0,
                "take_profit": 0.0,
                "holding_minutes": 0,
                "max_hold_hours": 0,
                "atr": 0.0,
            }

        if m5_trend > 0.0003 and m5_momentum > 0:
            score += 0.15
            confirmation_count += 1
            reasons.append("M5 refinement bullish")
        elif m5_trend < -0.0003 and m5_momentum < 0:
            score -= 0.15
            confirmation_count += 1
            reasons.append("M5 refinement bearish")
        else:
            return {
                "symbol": symbol,
                "direction": "FLAT",
                "score": 0.0,
                "confidence": 0.0,
                "status": "SKIPPED",
                "reason": "M5 confirmation failed",
                "risk": 0.0,
                "stop_loss": 0.0,
                "take_profit": 0.0,
                "holding_minutes": 0,
                "max_hold_hours": 0,
                "atr": 0.0,
            }

        if h4_trend > 0 and h1_trend > 0 and m15_trend > 0 and m5_trend > 0:
            score += 0.10
            reasons.append("full alignment")
        elif h4_trend < 0 and h1_trend < 0 and m15_trend < 0 and m5_trend < 0:
            score -= 0.10
            reasons.append("full alignment")

        if h4_momentum > 0 and h1_momentum > 0 and m15_momentum > 0:
            score += 0.05
        elif h4_momentum < 0 and h1_momentum < 0 and m15_momentum < 0:
            score -= 0.05

        confidence = min(0.99, 0.58 + (confirmation_count * 0.08) + abs(score) * 0.22)

        direction = "FLAT"
        if score > 0.55 and confidence >= 0.65:
            direction = "BUY"
        elif score < -0.55 and confidence >= 0.65:
            direction = "SELL"

        reason = " • ".join(reasons[:3]) if reasons else "multi-timeframe intraday setup"

        if direction == "FLAT":
            return {
                "symbol": symbol,
                "direction": "FLAT",
                "score": 0.0,
                "confidence": 0.0,
                "status": "SKIPPED",
                "reason": "low conviction",
                "risk": 0.0,
                "stop_loss": 0.0,
                "take_profit": 0.0,
                "holding_minutes": 0,
                "max_hold_hours": 0,
                "atr": 0.0,
            }

        latest_price = m5[-1]
        atr = calculate_atr(m5, period=14)
        if atr <= 0:
            atr = 0.0005 * latest_price

        if direction == "BUY":
            stop_loss = latest_price - atr * 1.2
            take_profit = latest_price + atr * 2.2
        else:
            stop_loss = latest_price + atr * 1.2
            take_profit = latest_price - atr * 2.2

        return {
            "symbol": symbol,
            "direction": direction,
            "score": round(score, 4),
            "confidence": round(confidence, 4),
            "status": "ACTIVE",
            "reason": reason,
            "risk": 0.008,
            "stop_loss": round(stop_loss, 6),
            "take_profit": round(take_profit, 6),
            "holding_minutes": 30,
            "max_hold_hours": 4,
            "atr": round(atr, 6),
        }

# ----------------------------
# Risk manager
# ----------------------------
class RiskManager:
    def __init__(self):
        self.active_positions = {}
        self.daily_trade_count = 0
        self.daily_pnl = 0.0

    def can_trade(self, signal: dict) -> bool:
        if signal["status"] == "SKIPPED":
            return False

        if signal["confidence"] < 0.65:
            return False

        if signal["symbol"] in self.active_positions:
            return False

        if self.daily_trade_count >= 1:
            return False

        if self.daily_pnl <= -200:
            return False

        if signal.get("atr", 0) <= 0:
            return False

        return True

# ----------------------------
# Trade service
# ----------------------------
class TradeService:
    def record_trade(self, symbol: str, direction: str, score: float, confidence: float, status: str, pnl: float = 0.0):
        conn = get_connection()
        conn.execute("""
            INSERT INTO trade_history (symbol, direction, score, confidence, status, pnl)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (symbol, direction, score, confidence, status, pnl))
        conn.commit()
        conn.close()

    def get_history(self):
        conn = get_connection()
        rows = conn.execute("""
            SELECT symbol, direction, score, confidence, status, pnl, created_at
            FROM trade_history
            ORDER BY created_at DESC
            LIMIT 100
        """).fetchall()
        conn.close()
        return [dict(row) for row in rows]

