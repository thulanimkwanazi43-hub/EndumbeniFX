FINNHUB_BASE = "https://finnhub.io/api/v1"

def _resample_h4_from_h1(values):
    resampled = []
    for i in range(0, len(values) - 3, 4):
        block = values[i:i+4]
        if len(block) == 4:
            resampled.append(sum(block) / 4)
    return resampled

def _fetch_finnhub_candles(symbol: str, resolution: str, days_back: int):
    if not FINNHUB_API_KEY:
        return {"error": "No Finnhub key"}

    from_ts = int(time.time()) - (days_back * 24 * 60 * 60)
    to_ts = int(time.time())

    url = f"{FINNHUB_BASE}/stock/candle"
    params = {
        "symbol": symbol,
        "resolution": resolution,
        "from": from_ts,
        "to": to_ts,
        "token": FINNHUB_API_KEY,
    }

    response = requests.get(url, params=params, timeout=15)
    if response.status_code != 200:
        return {"error": f"HTTP {response.status_code}"}

    data = response.json()
    if data.get("s") != "ok":
        return {"error": data}

    closes = data.get("c", [])
    timestamps = data.get("t", [])

    return {
        "labels": [str(ts) for ts in timestamps],
        "values": [float(v) for v in closes],
    }

def _fetch_yahoo_fallback(symbol: str):
    ticker = ASSET_UNIVERSE.get(symbol)
    if not ticker:
        return {"error": "No mapping"}

    try:
        data = yf.download(ticker, period="1mo", interval="1h", progress=False, auto_adjust=False)
        if data.empty:
            return {"error": "No data"}

        closes = [float(v) for v in data["Close"].tail(200).tolist()]
        labels = [str(index) for index in data["Close"].tail(200).index]
        return {"labels": labels, "values": closes}
    except Exception as exc:
        return {"error": str(exc)}

def fetch_symbol_data(symbol: str) -> Dict:
    provider_symbol = ASSET_UNIVERSE.get(symbol)
    if not provider_symbol:
        return {"symbol": symbol, "error": "No symbol mapping"}

    if FINNHUB_API_KEY:
        h1 = _fetch_finnhub_candles(provider_symbol, resolution="60", days_back=90)
        m15 = _fetch_finnhub_candles(provider_symbol, resolution="15", days_back=30)
        m5 = _fetch_finnhub_candles(provider_symbol, resolution="5", days_back=7)

        if "error" not in h1 and "error" not in m15 and "error" not in m5:
            h1_values = h1.get("values", [])[-200:]
            m15_values = m15.get("values", [])[-200:]
            m5_values = m5.get("values", [])[-200:]
            h4_values = _resample_h4_from_h1(h1_values)

            return {
                "symbol": symbol,
                "provider_symbol": provider_symbol,
                "timeframes": {
                    "H4": h4_values,
                    "H1": h1_values,
                    "M15": m15_values,
                    "M5": m5_values,
                },
                "labels": h1.get("labels", [])[-200:],
                "values": h1_values,
            }

    fallback = _fetch_yahoo_fallback(symbol)
    if "error" in fallback:
        return {"symbol": symbol, "error": "No data"}

    values = fallback.get("values", [])[-200:]
    h4_values = _resample_h4_from_h1(values)

    return {
        "symbol": symbol,
        "provider_symbol": provider_symbol,
        "timeframes": {
            "H4": h4_values,
            "H1": values,
            "M15": values[-100:],
            "M5": values[-50:],
        },
        "labels": fallback.get("labels", [])[-200:],
        "values": values,
    }

def fetch_market_snapshot() -> Dict[str, Dict]:
    snapshot = {}
    for symbol in ASSET_UNIVERSE.keys():
        snapshot[symbol] = fetch_symbol_data(symbol)
    return snapshot

