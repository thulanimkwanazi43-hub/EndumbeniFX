@app.on_event("startup")
async def startup_event():
    init_db()

@app.get("/")
async def root():
    return HTMLResponse(INDEX_HTML)

@app.get("/api/health")
async def health():
    return {"status": "ok", "service": APP_NAME}

@app.get("/api/dashboard")
async def dashboard():
    snapshot = fetch_market_snapshot()
    signals = []

    for symbol, payload in snapshot.items():
        if "error" in payload:
            continue

        signal = signal_engine.evaluate(symbol, payload)

        live_price = live_store.get(symbol)
        if live_price:
            signal["live_price"] = live_price

        if risk_manager.can_trade(signal):
            signal["status"] = "ACTIVE"
            risk_manager.active_positions[symbol] = signal
            risk_manager.daily_trade_count += 1
        else:
            signal["status"] = "SKIPPED"

        signals.append(signal)

        conn = get_connection()
        conn.execute("""
            INSERT INTO signals (symbol, direction, score, confidence, status, reason, risk, stop_loss, take_profit)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            signal["symbol"],
            signal["direction"],
            signal["score"],
            signal["confidence"],
            signal["status"],
            signal["reason"],
            signal["risk"],
            signal["stop_loss"],
            signal["take_profit"],
        ))
        conn.commit()
        conn.close()

    return {
        "app_name": APP_NAME,
        "signals": signals,
        "active_positions": len(risk_manager.active_positions),
        "daily_pnl": risk_manager.daily_pnl,
        "risk_status": "OK" if len(risk_manager.active_positions) < 3 else "LIMITED",
    }

@app.get("/api/history")
async def history():
    conn = get_connection()
    rows = conn.execute("""
        SELECT symbol, direction, score, confidence, status, pnl, created_at
        FROM trade_history
        ORDER BY created_at DESC
        LIMIT 100
    """).fetchall()
    conn.close()
    return {"items": [dict(row) for row in rows]}

@app.get("/api/chart/{symbol}")
async def chart(symbol: str):
    snapshot = fetch_market_snapshot()
    data = snapshot.get(symbol.upper())
    if not data or "error" in data:
        return {"symbol": symbol.upper(), "labels": [], "values": []}

    return {
        "symbol": symbol.upper(),
        "labels": data["labels"],
        "values": data["values"],
    }

@app.post("/api/trade_result")
async def trade_result(payload: dict):
    symbol = payload.get("symbol")
    direction = payload.get("direction", "FLAT")
    pnl = float(payload.get("pnl", 0.0))
    score = float(payload.get("score", 0.0))
    confidence = float(payload.get("confidence", 0.0))

    risk_manager.daily_pnl += pnl
    conn = get_connection()
    conn.execute("""
        INSERT INTO trade_history (symbol, direction, score, confidence, status, pnl)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (symbol, direction, score, confidence, "CLOSED", pnl))
    conn.commit()
    conn.close()
    return {"status": "ok"}

